DATABASE_URL=postgresql+psycopg://with_bader:<password>@localhost:5433/with_bader

# --- Authentication ---
# Generate a real secret per environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real production value.
ENVIRONMENT=development
AUTH_SECRET=
AUTH_COOKIE_NAME=with_bader_session
# Minutes - 20160 = 14 days.
AUTH_TOKEN_EXPIRE_MINUTES=20160

RESEARCH_SEARCH_PROVIDER=exa
RESEARCH_FALLBACK_PROVIDER=tavily
RESEARCH_SEARCH_TIMEOUT_SECONDS=15
RESEARCH_SOURCE_CONTENT_MAX_CHARS=2000

EXA_API_KEY=
TAVILY_API_KEY=

# Kept modest by default to fit Groq's free/on-demand tier tokens-per-minute
# budget (8000 TPM observed for openai/gpt-oss-20b). Raise on a paid tier.
RESEARCH_EXTRACTOR_PROVIDER=groq
RESEARCH_EXTRACTOR_MAX_SOURCES=8
RESEARCH_EXTRACTOR_MAX_SOURCE_CHARS=700

QUESTION_GENERATOR_PROVIDER=groq
QUESTION_GENERATION_DEFAULT_COUNT=12
QUESTION_GENERATION_MAX_COUNT=20
QUESTION_GENERATION_MAX_RESEARCH_ITEMS=30
QUESTION_GENERATION_MAX_INPUT_CHARS=12000

QUESTION_IMPROVER_PROVIDER=groq
GROQ_QUESTION_IMPROVEMENT_MODEL=openai/gpt-oss-120b

GROQ_API_KEY=
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
GROQ_QUESTION_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
# 3000 (raised from 1800, paid-tier upgrade 2026-09-06) - see
# app/core/config.py's groq_max_output_tokens docstring.
GROQ_MAX_OUTPUT_TOKENS=3000
# "medium" (raised from "low", 2026-09-06) - only research extraction
# currently reads this setting.
GROQ_REASONING_EFFORT=medium

# Speech-to-text via Groq Whisper (reuses GROQ_API_KEY above - no separate
# STT key). Verified against Groq's official docs 2026-09-06:
# STT_DIRECT_MAX_BYTES=104857600 (100MB) matches Groq's paid/dev-tier
# direct-upload limit (25MB on the free tier); a file over that is
# automatically normalized + split into STT_CHUNK_MINUTES-long parts via
# ffmpeg before transcription (see app/audio/chunking.py) - ffmpeg must be
# installed on the server for that path (direct uploads work without it).
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ar
STT_DIRECT_MAX_BYTES=104857600
STT_CHUNK_MINUTES=15
STT_MAX_FILE_SIZE_MB=500
STT_TIMEOUT_SECONDS=60
STT_ALLOWED_EXTENSIONS=.flac,.mp3,.mp4,.mpeg,.mpga,.m4a,.ogg,.wav,.webm

# Kept lower than a naive "30000" chars given the same Groq free-tier TPM
# budget noted above - see app/core/config.py for the reasoning.
INTERVIEW_MATCHER_PROVIDER=groq
GROQ_INTERVIEW_MATCHER_MODEL=openai/gpt-oss-20b
INTERVIEW_MATCHER_MAX_TRANSCRIPT_CHARS=12000
INTERVIEW_MATCHER_MAX_QUESTIONS=50
INTERVIEW_MATCHER_AUTO_SAVE_CONFIDENCE=0.75

CONTENT_GENERATOR_PROVIDER=groq
GROQ_CONTENT_MODEL=openai/gpt-oss-120b
CONTENT_GENERATION_MAX_ANSWERS=12
CONTENT_GENERATION_MAX_NOTEBOOK_BLOCKS=15
CONTENT_GENERATION_MAX_RESEARCH_ITEMS=10
CONTENT_GENERATION_MAX_QUESTIONS=8
CONTENT_GENERATION_MAX_TRANSCRIPT_CHARS=4000
CONTENT_GENERATION_MAX_INPUT_CHARS=10000

# Design slide planning (structured text via Groq) - the Design Engine is a
# deterministic frontend template renderer; AI only ever writes slide text,
# never an image (the old OpenRouter/Gemini image-generation path has been
# removed).
SLIDE_PLANNER_PROVIDER=groq
GROQ_SLIDE_PLANNER_MODEL=openai/gpt-oss-120b
